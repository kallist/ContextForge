{
  "name": "@kallist/contextforge",
  "version": "0.1.1",
  "description": "Local-first, task-aware context compiler for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kallist/ContextForge.git"
  },
  "bugs": {
    "url": "https://github.com/kallist/ContextForge/issues"
  },
  "homepage": "https://github.com/kallist/ContextForge#readme",
  "keywords": [
    "coding-agents",
    "context",
    "mcp",
    "repository-analysis"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "bin": {
    "contextforge": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json && node scripts/copy-parser-assets.mjs dist/adapters/parser/assets",
    "build:test": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node scripts/copy-parser-assets.mjs .test-dist/src/adapters/parser/assets",
    "build:benchmark": "node scripts/clean.mjs .benchmark-dist && tsc -p tsconfig.benchmark.json && node scripts/copy-parser-assets.mjs .benchmark-dist/src/adapters/parser/assets",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build && npm run build:test",
    "test": "node --test \".test-dist/test/**/*.test.js\"",
    "smoke": "node dist/cli/main.js --help",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:hardening": "node scripts/release-hardening.mjs",
    "release:check": "node scripts/release-check.mjs",
    "benchmark:validate": "npm run build:benchmark && node .benchmark-dist/benchmarks/src/cli.js validate",
    "benchmark:smoke": "npm run build:benchmark && node .benchmark-dist/benchmarks/src/cli.js smoke",
    "benchmark:quality": "npm run build:benchmark && node .benchmark-dist/benchmarks/src/cli.js quality",
    "benchmark:performance": "npm run build:benchmark && node .benchmark-dist/benchmarks/src/cli.js performance",
    "performance:mcp": "npm run build && node scripts/mcp-performance.mjs",
    "benchmark": "npm run build:benchmark && node .benchmark-dist/benchmarks/src/cli.js full",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ignore": "^7.0.6",
    "web-tree-sitter": "0.26.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.0.0",
    "globals": "^17.11.0",
    "tree-sitter-wasm": "1.1.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
